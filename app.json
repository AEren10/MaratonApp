{
  "expo": {
    "name": "Maraton",
    "slug": "maraton",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "maraton",
    "description": "YKS hazırlık sürecini takip et: günlük plan, deneme analizi, yanlış defteri.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ahmeterensiranli.maraton",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:maraton.app"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Yanlış soru fotoğrafı eklemek için galeri erişimi gerekli.",
        "NSCameraUsageDescription": "Yanlış soru fotoğrafı çekmek için kamera erişimi gerekli.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Çalışma hatırlatmaları ve streak bildirimleri göndermek için bildirim izni gerekli."
      }
    },
    "android": {
      "package": "com.ahmeterensiranli.maraton",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "maraton.app",
              "pathPrefix": "/referral"
            },
            {
              "scheme": "https",
              "host": "maraton.app",
              "pathPrefix": "/friend"
            },
            {
              "scheme": "https",
              "host": "maraton.app",
              "pathPrefix": "/group"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "@sentry/react-native/expo",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F5A623",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yanlış soru fotoğrafı eklemek için galeri erişimi gerekli.",
          "cameraPermission": "Yanlış soru fotoğrafı çekmek için kamera erişimi gerekli."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Paylaşım kartını galerine kaydetmek için izin gerekli.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@sentry/react-native",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0F"
        }
      ],
      "expo-status-bar",
      "expo-asset",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MaratonToday",
              "displayName": "Bugün",
              "description": "Günlük hedefin, serin ve sıradaki durağın.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            },
            {
              "name": "MaratonReview",
              "displayName": "Tekrar",
              "description": "Tekrarı gelen yanlış soruların.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            },
            {
              "name": "MaratonRoute",
              "displayName": "Rota",
              "description": "Sınava kalan gün ve net artışın.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            },
            {
              "name": "MaratonWeek",
              "displayName": "Bu hafta",
              "description": "Haftanın çözülen soruları ve günlük hedef.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "instagram",
            "instagram-stories"
          ],
          "android": [
            "com.instagram.android"
          ]
        }
      ],
      "expo-widgets"
    ],
    "extra": {
      "eas": {
        "projectId": "b7c40c1c-f724-4c07-ad36-696ef890ce64"
      }
    },
    "owner": "ahmeterenn",
    "updates": {
      "url": "https://u.expo.dev/b7c40c1c-f724-4c07-ad36-696ef890ce64"
    }
  }
}
