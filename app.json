{
  "expo": {
    "name": "Maraton",
    "slug": "maraton",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "appVersion" },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "maraton",
    "description": "YKS hazırlık sürecini takip et: günlük plan, deneme analizi, yanlış defteri.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ahmeterensiranli.maraton",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:maratonapp.com"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Yanlış soru fotoğrafı ve profil fotoğrafı eklemek, story paylaşımına arka plan seçmek için galeri erişimi gerekli.",
        "NSCameraUsageDescription": "Yanlış soru fotoğrafı ve profil fotoğrafı çekmek için kamera erişimi gerekli.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Çalışma hatırlatmaları ve seri bildirimleri göndermek için bildirim izni gerekli.",
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.ahmeterensiranli.maraton",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "maratonapp.com",
              "pathPrefix": "/referral"
            },
            {
              "scheme": "https",
              "host": "maratonapp.com",
              "pathPrefix": "/friend"
            },
            {
              "scheme": "https",
              "host": "maratonapp.com",
              "pathPrefix": "/group"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#1C1C23"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "maraton-ew",
          "project": "react-native"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E5343F",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yanlış soru fotoğrafı ve profil fotoğrafı eklemek, story paylaşımına arka plan seçmek için galeri erişimi gerekli.",
          "cameraPermission": "Yanlış soru fotoğrafı ve profil fotoğrafı çekmek için kamera erişimi gerekli.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Paylaşım kartını galerine kaydetmek için izin gerekli.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 220,
          "backgroundColor": "#1C1C23"
        }
      ],
      "expo-status-bar",
      "expo-asset",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.ahmeterensiranli.maraton.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.ahmeterensiranli.maraton",
          "widgets": [
            {
              "name": "MaratonToday",
              "displayName": "Bugün",
              "description": "Bugünün işleri ve sıradaki durağın. Kilit ekranına da eklenir.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "MaratonRoute",
              "displayName": "Rota",
              "description": "Sınava kalan gün ve net çizgin. Kilit ekranına da eklenir.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "MaratonWeek",
              "displayName": "Bu hafta",
              "description": "Haftanın çözülen soruları ve günlük hedef.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "MaratonStreak",
              "displayName": "Seri",
              "description": "Serin ve son dört haftanın çalışma ızgarası.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "MaratonTrial",
              "displayName": "Deneme",
              "description": "Son denemelerinin net çizgisi ve ders ders değişim.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "instagram",
            "instagram-stories"
          ],
          "android": [
            "com.instagram.android"
          ]
        }
      ],
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "b7c40c1c-f724-4c07-ad36-696ef890ce64"
      }
    },
    "owner": "ahmeterenn",
    "updates": {
      "url": "https://u.expo.dev/b7c40c1c-f724-4c07-ad36-696ef890ce64"
    }
  }
}
