# Maraton — ortam degiskenleri sablonu
#
# Gercek degerleri .env.local dosyasina yaz (o dosya .gitignore'da).
# EXPO_PUBLIC_ onekli degiskenler uygulama paketine GOMULUR: bunlar
# "gizli" degildir, yalnizca yayinlanabilir/publishable anahtarlar
# konulmalidir. Service role anahtari ya da RevenueCat secret key
# BURAYA VE .env.local'A ASLA KONMAZ.

# --- Supabase (ZORUNLU) ---
# Panel > Project Settings > API. Anon/publishable key, service_role DEGIL.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# --- RevenueCat (satin alma icin ZORUNLU) ---
# Panel > Project > API keys > "App specific" public SDK keys.
# iOS anahtari "appl_", Android anahtari "goog_" ile baslar.
#
# BOS BIRAKILIRSA: src/lib/purchases.js baslatmaz, paywall'daki satin alma
# butonu "Satin alma hazir degil" der ve durur. Uygulamanin geri kalani
# calisir; yalnizca odeme kapalidir. Uretimde bos birakilamaz.
#
# DIKKAT: buraya "test" gibi rastgele bir deger YAZMA. isConfiguredKey()
# yalnizca "YOUR_" onekini eliyor, gecersiz bir anahtar yapilandirilmis
# sayilir ve temiz "kapali" yolu yerine anlasilmaz SDK hatasi alirsin.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# --- Sentry (istege bagli) ---
# Bos birakilirsa hata raporlama sessizce kapali kalir.
# Ayrica app.json'daki @sentry/react-native/expo plugin'i organization ve
# project bekliyor; onlar da eksikse derleme uyarisi veriyor.
EXPO_PUBLIC_SENTRY_DSN=

# --- Google ile giris (istege bagli) ---
# Bos birakilirsa Google giris butonu calismaz; e-posta girisi etkilenmez.
# Ayrica app.json > plugins > @react-native-google-signin/google-signin
# icindeki iosUrlScheme hala PLACEHOLDER_IOS_CLIENT_ID -- gercek iOS
# client id'nin ters cevrilmis hali ile degistirilmeli.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
